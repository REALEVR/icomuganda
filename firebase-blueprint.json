{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile accumulating game score",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "User ID" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "score": { "type": "number", "description": "Total score from playing the guessing game" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "score", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "Stores user profiles with their game scores"
    }
  }
}
