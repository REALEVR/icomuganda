rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { allow read, write: if false; }

    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }

    // Kept in sync with NETWORK_ADMIN_EMAILS in src/lib/admin.ts.
    // Only these ICOM Uganda network admins can review museum
    // applications and manage the public directory.
    function isNetworkAdmin() {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() in ['icomuganda@gmail.com'];
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'score', 'createdAt', 'updatedAt'])
        && data.keys().size() >= 5
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 256
        && (data.get('displayName', '') is string && data.get('displayName', '').size() <= 100)
        && data.score is number && data.score >= 0
        && data.createdAt is string
        && data.updatedAt is string;
    }

    function isValidUserUpdate(data) {
        return data.keys().hasAll(['uid', 'email', 'score', 'createdAt', 'updatedAt'])
        && data.uid == existing().uid
        && data.email == existing().email
        && (data.get('displayName', '') is string && data.get('displayName', '').size() <= 100)
        && data.score is number && data.score >= 0
        && data.createdAt == existing().createdAt
        && data.updatedAt is string;
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn(); // Everyone can see leaderboard
      allow create: if isSignedIn() && isValidId(userId) && userId == request.auth.uid && isValidUser(incoming());
      allow update: if (
        isSignedIn()
        && isValidId(userId)
        && userId == request.auth.uid
        && isValidUserUpdate(incoming())
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['score', 'updatedAt', 'displayName'])
        )
      );
    }
    
    match /questions/{questionId} {
      allow read: if true;
      // src/pages/Game.tsx seeds this collection client-side (unauthenticated)
      // the first time it finds it empty, writing to a fixed, known doc id
      // per question — so `create` on a not-yet-existing id is legitimate.
      // `if true` here let anyone overwrite or delete already-seeded
      // questions (e.g. rewrite a question's `correct` answer) at any time,
      // not just during that initial seed.
      allow create: if !exists(/databases/$(database)/documents/questions/$(questionId));
      allow update, delete: if false;
    }

    // Museum Network — applications submitted by museums wanting to join
    // the East African directory. Anyone can submit one (the public
    // "Register Your Museum" form); only network admins may read the
    // queue and review/approve/reject entries.
    function isValidApplication(data) {
      return data.keys().hasAll(['museumName', 'country', 'region', 'culture', 'description', 'contactName', 'contactEmail', 'status'])
        && data.museumName is string && data.museumName.size() > 0 && data.museumName.size() <= 200
        && data.country is string && data.country.size() <= 100
        && data.region is string && data.region.size() <= 100
        && data.culture is string && data.culture.size() <= 100
        && data.description is string && data.description.size() <= 4000
        && data.contactName is string && data.contactName.size() <= 200
        && data.contactEmail is string && data.contactEmail.size() <= 256
        && data.status == 'pending';
    }

    match /museumApplications/{applicationId} {
      allow create: if isValidApplication(incoming());
      allow get: if isNetworkAdmin();
      allow list: if isNetworkAdmin();
      allow update: if isNetworkAdmin()
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewedAt', 'rejectionReason']);
      allow delete: if isNetworkAdmin();
    }

    // Museum Network — the public directory of approved member museums,
    // categorised by country, region, and culture. Published only by
    // network admins after an application is approved.
    match /museums/{museumId} {
      allow read: if true;
      allow write: if isNetworkAdmin();
    }
  }
}
